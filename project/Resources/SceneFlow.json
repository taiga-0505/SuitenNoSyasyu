{
  "version": 1,
  "rules": [
    {
      "from": "Title",
      "trigger": "start",
      "to": "Select",
      "transition": "dive",
      "note": "タイトルの「スタート」"
    },
    {
      "from": "Select",
      "trigger": "back",
      "to": "Title",
      "transition": "dive",
      "note": "ステージセレクトで ESC（飛び込んで戻り、Title は深海から浮上）"
    },
    {
      "from": "Select",
      "trigger": "stage",
      "to": "$arg",
      "transition": "dive",
      "note": "出航（選んだステージへ）"
    },
    {
      "from": "Stage*",
      "trigger": "cleared",
      "to": "Result",
      "transition": "ascend",
      "note": "ステージクリア（ClearAscendScript が空へ跳ね上がって白く飛んでから遷移）"
    },
    {
      "from": "Stage*",
      "trigger": "gameover",
      "to": "Result",
      "transition": "dive",
      "note": "力尽きた（DeathSink が沈みきってから遷移）"
    },
    {
      "from": "Stage*",
      "trigger": "pause_retry",
      "to": "$current",
      "transition": "dive",
      "note": "ポーズ「はじめから」（画面を深海色へ沈めてから遷移し、深海から浮上してやり直す）"
    },
    {
      "from": "Stage*",
      "trigger": "pause_exit",
      "to": "Select",
      "transition": "dive",
      "note": "ポーズ「セレクトへ」（画面を深海色へ沈めてから遷移し、セレクトは深海から浮上）"
    },
    {
      "from": "Stage*",
      "trigger": "demo_end",
      "to": "Title",
      "transition": "dive",
      "note": "遷移の見せ用デモ（TransitionDemo::kEnabled）：開始 3 秒後に沈んでタイトルへ"
    },
    {
      "from": "Result",
      "trigger": "next",
      "to": "$nextStage",
      "transition": "dive",
      "note": "リザルト「次のステージへ」（最終面では出ない）"
    },
    {
      "from": "Result",
      "trigger": "retry",
      "to": "$lastPlay",
      "transition": "dive",
      "note": "リザルト「もう一度」"
    },
    {
      "from": "Result",
      "trigger": "select",
      "to": "Select",
      "transition": "dive",
      "note": "リザルト「セレクトへ」"
    },
    {
      "from": "Result",
      "trigger": "title",
      "to": "Title",
      "transition": "dive",
      "note": "リザルト「タイトルへ」（ステージ以外から来たとき。エディタで直接開いた場合など）"
    }
  ]
}