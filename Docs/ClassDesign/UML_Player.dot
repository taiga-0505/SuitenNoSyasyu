digraph G { graph [rankdir=BT, fontname="Noto Sans CJK JP", fontsize=18, label="自機（RailShooterController）のクラス設計（Strategy / State / Object Pool）", labelloc=t, nodesep=0.5, ranksep=0.7, bgcolor="white", pad=0.4];
node [shape=plain, fontname="Noto Sans CJK JP", fontsize=11];
edge [fontname="Noto Sans CJK JP", fontsize=10];
"ScriptableEntity" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">&laquo;engine&raquo;</FONT><BR/><B>ScriptableEntity</B></TD></TR></TABLE>>];
"RailShooterController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>RailShooterController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-weapons_ : WeaponSelector<BR/>-bulletPool_ : EntityPool<BR/>-waterFsm_ : StateMachine<BR/>-lifeFsm_ : StateMachine</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnUpdate(dt)<BR/>-Fire()</TD></TR></TABLE>>];
"WeaponSelector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><B>WeaponSelector</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-weapons_ : vector&lt;unique_ptr&lt;IWeapon&gt;&gt;<BR/>-index_ : size_t</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Current() : const IWeapon&amp;<BR/>+SelectNext() / SelectPrevious()</TD></TR></TABLE>>];
"IWeapon" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><FONT POINT-SIZE="10">&laquo;Strategy&raquo;</FONT><BR/><B>IWeapon</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+BulletTypeTag() : pure<BR/>+ShotCount() : virtual<BR/>+AimPoint(center, i) : virtual<BR/>+BulletScale() : pure<BR/>+Cooldown(base) : virtual<BR/>+HudColor(a) : pure</TD></TR></TABLE>>];
"NormalWeapon" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><B>NormalWeapon</B></TD></TR></TABLE>>];
"SpreadWeapon" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><B>SpreadWeapon</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ShotCount() → 3<BR/>+AimPoint() → ±80px</TD></TR></TABLE>>];
"HeavyWeapon" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><B>HeavyWeapon</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Cooldown() → 2倍</TD></TR></TABLE>>];
"EntityPool" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><FONT POINT-SIZE="10">&laquo;Object Pool&raquo;</FONT><BR/><B>EntityPool</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Acquire(scene) : Lease</TD></TR></TABLE>>];
"StateMachine" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><FONT POINT-SIZE="10">&laquo;template&raquo;</FONT><BR/><B>StateMachine&lt;Owner&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ChangeState&lt;S&gt;()<BR/>+Update(owner, dt)</TD></TR></TABLE>>];
"IState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><FONT POINT-SIZE="10">&laquo;interface&raquo;</FONT><BR/><B>IState&lt;Owner&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+OnEnter / OnUpdate / OnExit</TD></TR></TABLE>>];
"SurfaceState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>SurfaceState</B></TD></TR></TABLE>>];
"UnderwaterState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>UnderwaterState</B></TD></TR></TABLE>>];
"LifeState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><FONT POINT-SIZE="10">&laquo;abstract&raquo;</FONT><BR/><B>LifeState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+CanAct() : pure<BR/>+TakeDamage(...) : pure<BR/>+DrawOverlayText(...) : pure<BR/>+DrawScreenBand(...) : pure</TD></TR></TABLE>>];
"AliveState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>AliveState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+TakeDamage(...)  → HP減少</TD></TR></TABLE>>];
"PlayingState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>PlayingState</B></TD></TR></TABLE>>];
"ClearedState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>ClearedState</B></TD></TR></TABLE>>];
"DeadState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>DeadState</B></TD></TR></TABLE>>];
"RailShooterController" -> "ScriptableEntity" [arrowhead=onormal, arrowsize=1.3];
"WeaponSelector" -> "RailShooterController" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="1"];
"IWeapon" -> "WeaponSelector" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="3"];
"NormalWeapon" -> "IWeapon" [arrowhead=onormal, arrowsize=1.3];
"SpreadWeapon" -> "IWeapon" [arrowhead=onormal, arrowsize=1.3];
"HeavyWeapon" -> "IWeapon" [arrowhead=onormal, arrowsize=1.3];
"EntityPool" -> "RailShooterController" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="1"];
"StateMachine" -> "RailShooterController" [arrowhead=diamond, arrowsize=1.4, label="waterFsm_ / lifeFsm_", taillabel="2"];
"IState" -> "StateMachine" [arrowhead=diamond, arrowsize=1.4, label="current", taillabel="0..1"];
"SurfaceState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"UnderwaterState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"LifeState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"AliveState" -> "LifeState" [arrowhead=onormal, arrowsize=1.3];
"DeadState" -> "LifeState" [arrowhead=onormal, arrowsize=1.3];
"PlayingState" -> "AliveState" [arrowhead=onormal, arrowsize=1.3];
"ClearedState" -> "AliveState" [arrowhead=onormal, arrowsize=1.3];
}