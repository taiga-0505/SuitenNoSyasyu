digraph G { graph [rankdir=BT, fontname="Noto Sans CJK JP", fontsize=18, label="敵まわりのクラス設計（ポリモーフィズム / Template Method / State / Object Pool / Observer）", labelloc=t, nodesep=0.5, ranksep=0.7, bgcolor="white", pad=0.4];
node [shape=plain, fontname="Noto Sans CJK JP", fontsize=11];
edge [fontname="Noto Sans CJK JP", fontsize=10];
"ScriptableEntity" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee"><FONT POINT-SIZE="10">&laquo;engine&raquo;</FONT><BR/><B>ScriptableEntity</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnCreate()<BR/>#OnUpdate(dt)<BR/>+Serialize() / Deserialize()</TD></TR></TABLE>>];
"DamageableScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><FONT POINT-SIZE="10">&laquo;abstract&raquo;</FONT><BR/><B>DamageableScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-hp_ : int<BR/>-maxHp_ : int<BR/>-defeated_ : bool<BR/>-flashTimer_ : float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+TakeDamage(damage)<BR/>#OnUpdate(dt) final  ← Template Method<BR/>#OnUpdateAlive(dt) : virtual<BR/>#OnUpdateDefeated(dt) : virtual<BR/>#OnDefeated() : pure virtual<BR/>#OnDamaged(damage) : virtual<BR/>#DamageFlashColor() : virtual</TD></TR></TABLE>>];
"EnemyBaseScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>EnemyBaseScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-spawnDeathBubbles_ : bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-OnDefeated() final<BR/>#OnEnemyDefeated() : virtual<BR/>#SetDefaultDeathDuration(s)</TD></TR></TABLE>>];
"TreasureChestScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>TreasureChestScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-points_ : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnDefeated()  ← 開封<BR/>#OnUpdateDefeated(dt)<BR/>#ApplyColor(c)</TD></TR></TABLE>>];
"SharkEnemyScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>SharkEnemyScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fsm_ : StateMachine<BR/>-sense_ : SharkSense</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnUpdateAlive(dt)<BR/>#OnUpdateDefeated(dt)</TD></TR></TABLE>>];
"ShipEnemyScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>ShipEnemyScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fsm_ : StateMachine<BR/>-shellPool_ : EntityPool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnUpdateAlive(dt)<BR/>#OnEnemyDefeated()</TD></TR></TABLE>>];
"EnemyAI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>EnemyAI</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-bulletPool_ : EntityPool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnUpdateAlive(dt)<BR/>#OnUpdateDefeated(dt)</TD></TR></TABLE>>];
"OctopusEnemyScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>OctopusEnemyScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnDamaged(damage)</TD></TR></TABLE>>];
"BirdEnemyScript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f5"><B>BirdEnemyScript</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#OnDamaged(damage)<BR/>#OnEnemyDefeated()</TD></TR></TABLE>>];
"StateMachine" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><FONT POINT-SIZE="10">&laquo;template&raquo;</FONT><BR/><B>StateMachine&lt;Owner&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-current_ : unique_ptr&lt;IState&gt;<BR/>-pending_ : unique_ptr&lt;IState&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ChangeState&lt;S&gt;()<BR/>+Update(owner, dt)<BR/>+IsIn&lt;S&gt;() / CurrentName()</TD></TR></TABLE>>];
"IState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><FONT POINT-SIZE="10">&laquo;interface&raquo;</FONT><BR/><B>IState&lt;Owner&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+OnEnter(owner, machine)<BR/>+OnUpdate(owner, machine, dt) : pure<BR/>+OnExit(owner)<BR/>+Name() : pure</TD></TR></TABLE>>];
"WaitState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>WaitState</B></TD></TR></TABLE>>];
"ApproachState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>ApproachState</B></TD></TR></TABLE>>];
"AttackState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>AttackState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-attackTimer_ / hasHit_</TD></TR></TABLE>>];
"RetreatState" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#e3f1e0"><B>RetreatState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cooldownTimer_ / retreatTimer_</TD></TR></TABLE>>];
"EntityPool" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbeedd"><FONT POINT-SIZE="10">&laquo;Object Pool&raquo;</FONT><BR/><B>EntityPool</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-entityName_ : string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Acquire(scene) : Lease<BR/>+Release(entity)</TD></TR></TABLE>>];
"GameEvent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#f3e3f3"><FONT POINT-SIZE="10">&laquo;Observer: Subject&raquo;</FONT><BR/><B>GameEvent&lt;Args...&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-listeners_</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Subscribe(handler) : EventConnection<BR/>+Emit(args)</TD></TR></TABLE>>];
"EventConnection" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#f3e3f3"><FONT POINT-SIZE="10">&laquo;RAII&raquo;</FONT><BR/><B>EventConnection</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Disconnect()</TD></TR></TABLE>>];
"RailShooterGameMode" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#f3e3f3"><FONT POINT-SIZE="10">&laquo;Observer: 購読側&raquo;</FONT><BR/><B>RailShooterGameMode</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-enemyDefeatedConnection_ : EventConnection</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+OnSceneEnter()<BR/>+EvaluateOutcome()</TD></TR></TABLE>>];
"DamageableScript" -> "ScriptableEntity" [arrowhead=onormal, arrowsize=1.3];
"EnemyBaseScript" -> "DamageableScript" [arrowhead=onormal, arrowsize=1.3];
"TreasureChestScript" -> "DamageableScript" [arrowhead=onormal, arrowsize=1.3];
"SharkEnemyScript" -> "EnemyBaseScript" [arrowhead=onormal, arrowsize=1.3];
"ShipEnemyScript" -> "EnemyBaseScript" [arrowhead=onormal, arrowsize=1.3];
"EnemyAI" -> "EnemyBaseScript" [arrowhead=onormal, arrowsize=1.3];
"OctopusEnemyScript" -> "EnemyBaseScript" [arrowhead=onormal, arrowsize=1.3];
"BirdEnemyScript" -> "EnemyBaseScript" [arrowhead=onormal, arrowsize=1.3];
"StateMachine" -> "SharkEnemyScript" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="1"];
"IState" -> "StateMachine" [arrowhead=diamond, arrowsize=1.4, label="current", taillabel="0..1"];
"WaitState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"ApproachState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"AttackState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"RetreatState" -> "IState" [arrowhead=onormal, arrowsize=1.3];
"EntityPool" -> "ShipEnemyScript" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="1"];
"EntityPool" -> "EnemyAI" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="1"];
"EnemyBaseScript" -> "GameEvent" [style=dashed, arrowhead=vee, label="Emit(撃破)"];
"EventConnection" -> "RailShooterGameMode" [arrowhead=diamond, arrowsize=1.4, label="", taillabel="1"];
"RailShooterGameMode" -> "GameEvent" [style=dashed, arrowhead=vee, label="Subscribe"];
"EventConnection" -> "GameEvent" [style=dashed, arrowhead=vee, label="解除"];
}